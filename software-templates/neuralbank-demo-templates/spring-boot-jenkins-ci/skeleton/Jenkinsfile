pipeline {
  agent any
  environment {
    APP_NAME = '${{ values.component_id }}'
    OCP_NAMESPACE = '${{ values.namespace }}'
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Wait for GitOps resources') {
      steps {
        sh '''
          set -euo pipefail
          APP_NAME="${APP_NAME:-${JOB_NAME}}"
          NS="${OCP_NAMESPACE}"
          TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
          SERVER="https://kubernetes.default.svc:443"

          for i in $(seq 1 60); do
            if oc --token="${TOKEN}" --server="${SERVER}" --insecure-skip-tls-verify=true -n "${NS}" get bc "${APP_NAME}" >/dev/null 2>&1 \\
              && oc --token="${TOKEN}" --server="${SERVER}" --insecure-skip-tls-verify=true -n "${NS}" get deploy "${APP_NAME}" >/dev/null 2>&1; then
              echo "GitOps resources are present in ${NS}"
              exit 0
            fi
            echo "Waiting for ArgoCD to create BuildConfig/Deployment in ${NS}... (${i}/60)"
            sleep 5
          done

          echo "Timed out waiting for GitOps resources in ${NS}"
          exit 1
        '''
      }
    }
    stage('Build image (OpenShift BuildConfig)') {
      steps {
        sh '''
          set -euo pipefail
          APP_NAME="${APP_NAME:-${JOB_NAME}}"
          NS="${OCP_NAMESPACE}"
          TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
          SERVER="https://kubernetes.default.svc:443"

          oc --token="${TOKEN}" --server="${SERVER}" --insecure-skip-tls-verify=true -n "${NS}" start-build "bc/${APP_NAME}" --wait --follow
        '''
      }
    }
    stage('Deploy (rollout)') {
      steps {
        sh '''
          set -euo pipefail
          APP_NAME="${APP_NAME:-${JOB_NAME}}"
          NS="${OCP_NAMESPACE}"
          TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
          SERVER="https://kubernetes.default.svc:443"

          oc --token="${TOKEN}" --server="${SERVER}" --insecure-skip-tls-verify=true -n "${NS}" rollout status "deploy/${APP_NAME}" --timeout=10m
        '''
      }
    }
  }
}

